# Copy to .env.local for local development, or add these values in Vercel Project Settings → Environment Variables.

# Turso / libSQL Database Credentials (Required for persistent storage in production)
TURSO_CONNECTION_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Admin Authentication
ADMIN_PASSWORD=your-strong-production-admin-password
ADMIN_SECRET=your-random-32-plus-character-secret-key-for-session-signing

# Site Canonical URL
NEXT_PUBLIC_SITE_URL=https://mep.eomeg.in
